{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Gabe-Soler/arcadiabench/main/schemas/leaderboard-round.schema.json",
  "title": "ArcadiaBench leaderboard round",
  "description": "leaderboard/rounds/round-N.json: a round of the leaderboard. A round is the tag round-N on main; its seeds are computed from the tag's commit (site/tools/round-seeds.mjs), and every entry accepted by then is run on them. Each ranked entry's results are in its round-N/ directory.",
  "type": "object",
  "properties": {
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "tag": {
      "type": "string",
      "pattern": "^round-[1-9][0-9]{0,3}$"
    },
    "commit": {
      "description": "The commit the tag points at.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "catalog": {
      "type": "string"
    },
    "simulator": {
      "description": "The release of the simulator the round was run on.",
      "type": "string"
    },
    "seeds": {
      "description": "The round's seeds, ascending: none of them a public seed.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 51
      }
    },
    "entries": {
      "description": "The entries the round ranks.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      }
    },
    "not_ranked": {
      "description": "Entries accepted by the round's tag whose runs on its seeds did not come back, and why.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,31}$"
          },
          "image_digest": {
            "description": "The image the entry was run from.",
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "image_digest",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "round",
    "tag",
    "commit",
    "catalog",
    "simulator",
    "seeds",
    "entries",
    "not_ranked"
  ],
  "additionalProperties": false,
  "$defs": {
    "Entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,31}$"
        },
        "image_digest": {
          "description": "The image the entry was run from.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "image_digest"
      ],
      "additionalProperties": false
    }
  }
}
